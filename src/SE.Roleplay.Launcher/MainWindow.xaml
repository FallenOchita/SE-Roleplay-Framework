<Window x:Class="SE.Roleplay.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SE Roleplay" Height="760" Width="1180" MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen" Background="#0B0F16" Foreground="#F2F6FA"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#111722"><DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><TextBlock Text="SE ROLEPLAY" FontSize="21" FontWeight="Bold" Foreground="#53D6C5" Margin="2,10,0,3"/><TextBlock Text="COMMUNITY LAUNCHER" FontSize="9" Foreground="#8292A8" Margin="3,0,0,32"/><Button Content="SERVER BROWSER" HorizontalContentAlignment="Left" Background="#243443" Foreground="#EAF5F7" Margin="0,0,0,8" Click="ShowServers_Click"/><Button Content="DIRECT CONNECT" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B5C0CE" Margin="0,0,0,8" Click="ShowConnect_Click"/><Button Content="SETTINGS" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B5C0CE" Click="ShowSettings_Click"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8"><Border Height="1" Background="#293444" Margin="0,0,0,14"/><TextBlock Text="SPACE ENGINEERS" Foreground="#E7EDF5" FontWeight="SemiBold"/><TextBlock Text="Roleplay Framework · Early Access" Foreground="#8292A8" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="Launcher v0.1.0" Foreground="#64748B" FontSize="10" Margin="0,12,0,0"/></StackPanel></DockPanel></Border><Grid Grid.Column="1" Margin="34,28,34,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Margin="0,0,0,22"><TextBlock x:Name="PageEyebrow" Text="COMMUNITY" Foreground="#53D6C5" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text="Find your next story." FontSize="32" FontWeight="Bold" Margin="0,5,0,4"/><TextBlock x:Name="PageSubtitle" Text="Browse roleplay communities or connect directly to a server." Foreground="#9AA8BA" FontSize="13"/></StackPanel><Grid Grid.Row="1"><Grid x:Name="ServersPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="REFRESH LIST" Click="RefreshServers_Click"/><TextBlock x:Name="ServerCountText" Text="SERVER DIRECTORY" Foreground="#9AA8BA" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel><Border Grid.Row="1" Background="#121925" CornerRadius="12" Padding="18"><Grid><ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0" Foreground="#F2F6FA" SelectionChanged="ServerList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="#1A2432" CornerRadius="8" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Foreground="#9AA8BA" TextWrapping="Wrap" Margin="0,5,12,6"/><TextBlock Text="{Binding Region}" Foreground="#53D6C5" FontSize="10" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Population}" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="PLAYERS" Foreground="#8292A8" FontSize="9" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="#53D6C5" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding GameMode}" Foreground="#8292A8" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="EmptyServersPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"><TextBlock Text="No servers loaded yet" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="The community directory is not configured. Add its HTTPS endpoint in Settings, or use Direct Connect to join a server address." Foreground="#9AA8BA" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,18"/><Button Content="OPEN SETTINGS" Click="ShowSettings_Click" HorizontalAlignment="Center"/></StackPanel></Grid></Border></Grid><Border x:Name="ConnectPanel" Visibility="Collapsed" Background="#121925" CornerRadius="12" Padding="28"><StackPanel MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="JOIN A COMMUNITY" Foreground="#53D6C5" FontWeight="Bold" FontSize="11"/><TextBlock Text="Direct connect" FontSize="24" FontWeight="Bold" Margin="0,5,0,18"/><TextBlock Text="Server IP or hostname" Foreground="#9AA8BA" Margin="0,0,0,6"/><TextBox x:Name="AddressBox" Text="127.0.0.1" Margin="0,0,0,14"/><TextBlock Text="Port" Foreground="#9AA8BA" Margin="0,0,0,6"/><TextBox x:Name="PortBox" Text="27016" Margin="0,0,0,20"/><Button Content="CONNECT WITH STEAM" Click="Connect_Click" HorizontalAlignment="Left"/><TextBlock Text="Steam and Space Engineers must be installed. Connection is handed off to Steam; the launcher does not host the game server." Foreground="#8292A8" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border><Border x:Name="SettingsPanel" Visibility="Collapsed" Background="#121925" CornerRadius="12" Padding="28"><StackPanel MaxWidth="650" HorizontalAlignment="Left"><TextBlock Text="LAUNCHER CONFIGURATION" Foreground="#53D6C5" FontWeight="Bold" FontSize="11"/><TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,5,0,18"/><TextBlock Text="Server directory URL" Foreground="#9AA8BA" Margin="0,0,0,6"/><TextBox x:Name="DirectoryUrlBox" Margin="0,0,0,8"/><TextBlock Text="Optional HTTP(S) endpoint returning a JSON array of server entries. Leave blank until the public directory service is deployed." Foreground="#8292A8" TextWrapping="Wrap" Margin="0,0,0,18"/><TextBlock Text="Space Engineers Steam App ID" Foreground="#9AA8BA" Margin="0,0,0,6"/><TextBox x:Name="SteamAppIdBox" Text="244850" Margin="0,0,0,20"/><Button Content="SAVE SETTINGS" Click="SaveSettings_Click" HorizontalAlignment="Left"/></StackPanel></Border></Grid><DockPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Text="Ready. Configure a directory or connect directly." Foreground="#8292A8" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="NOT AFFILIATED WITH KEEN SOFTWARE" Foreground="#536174" FontSize="9" VerticalAlignment="Center"/></DockPanel></Grid></Grid></Window>