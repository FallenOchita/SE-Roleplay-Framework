<Window x:Class="SE.Roleplay.Framework.Launcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SE1 Roleplay" Height="820" Width="1280" MinHeight="700" MinWidth="1050"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Loaded="Window_Loaded">
 <Window.Resources>
  <DataTemplate x:Key="ServerCardTemplate">
   <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3742" BorderThickness="1" Padding="15" CornerRadius="9" Margin="0,0,0,10">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"/>
      <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,4"/>
      <WrapPanel>
       <TextBlock Text="{Binding Address}" Foreground="#C5D0D8" Margin="0,0,14,0"/>
       <TextBlock Text="{Binding Region}" Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0"/>
       <TextBlock Text="{Binding Players}" Foreground="{StaticResource AccentBrush}"/>
       <TextBlock Text=" players" Foreground="{StaticResource MutedBrush}"/>
       <TextBlock Text=" / " Foreground="{StaticResource MutedBrush}"/>
       <TextBlock Text="{Binding MaxPlayers}" Foreground="{StaticResource MutedBrush}"/>
       <TextBlock Text=" · " Foreground="{StaticResource MutedBrush}"/>
       <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}"/>
      </WrapPanel>
     </StackPanel>
     <Button Grid.Column="1" Content="JOIN" VerticalAlignment="Center" MinWidth="92" Tag="{Binding}" Click="JoinServer_Click" Background="{StaticResource AccentBrush}" Foreground="#0B1712"/>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#141B22" Padding="18">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="SE1 ROLEPLAY" FontSize="23" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,28"/>
     <Button x:Name="HomeNav" Content="HOME" Click="HomeNav_Click"/>
     <Button x:Name="ServersNav" Content="BROWSE SERVERS" Click="ServersNav_Click"/>
     <Button x:Name="CharactersNav" Content="CHARACTERS" Click="CharactersNav_Click"/>
     <Button x:Name="SettingsNav" Content="SETTINGS" Click="SettingsNav_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
     <TextBlock Text="FRAMEWORK" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
     <TextBlock x:Name="FrameworkStatusText" Text="Launcher ready" Margin="0,4,0,12"/>
     <TextBlock Text="SPACE ENGINEERS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
     <TextBlock x:Name="GameStatusText" Text="Steam launch ready" TextWrapping="Wrap" Margin="0,4"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,22,28,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="PageEyebrow" Text="SE1 COMMUNITY" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
     <TextBlock x:Name="PageTitle" Text="Home" FontSize="29" FontWeight="Bold"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="SteamAccountText" Text="Steam not connected" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <Button x:Name="SteamSignInButton" Content="SIGN IN WITH STEAM" Click="SteamSignIn_Click" Background="#263747"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <Border Background="#20352F" Padding="26" CornerRadius="13" Margin="0,0,0,22">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="YOUR UNIVERSE. YOUR STORY." Foreground="#A9E8CD" FontWeight="Bold" FontSize="12"/>
         <TextBlock Text="Space Engineers Roleplay" FontSize="30" FontWeight="Bold" Margin="0,8,0,5"/>
         <TextBlock Text="Discover roleplay communities, revisit your servers, and jump into the universe." TextWrapping="Wrap" Foreground="#D2E4DC"/>
         <WrapPanel Margin="0,14,0,0">
          <Button Content="BROWSE SERVERS" Click="BrowseServers_Click" Background="{StaticResource AccentBrush}" Foreground="#0B1712" FontWeight="Bold"/>
          <Button Content="PLAY SPACE ENGINEERS" Click="LaunchGame_Click" Background="#2C4840"/>
         </WrapPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#29473D" CornerRadius="12" Padding="22" Margin="20,0,0,0" VerticalAlignment="Center">
         <StackPanel HorizontalAlignment="Center"><TextBlock Text="SE1" FontSize="42" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock Text="ROLEPLAY HUB" FontSize="10" Foreground="#C2E8D6" HorizontalAlignment="Center"/></StackPanel>
        </Border>
       </Grid>
      </Border>
      <DockPanel Margin="0,0,0,10">
       <TextBlock Text="RECENTLY LAUNCHED" FontSize="18" FontWeight="Bold"/>
       <TextBlock DockPanel.Dock="Right" Text="Your recent server launches" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="RecentEmptyText" Text="No servers launched yet. Browse the directory and join a community to see it here." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <ItemsControl x:Name="RecentServerList" ItemTemplate="{StaticResource ServerCardTemplate}"/>
      <DockPanel Margin="0,16,0,10">
       <TextBlock Text="NEW &amp; DISCOVERABLE SERVERS" FontSize="18" FontWeight="Bold"/>
       <Button DockPanel.Dock="Right" Content="VIEW ALL" Click="BrowseServers_Click"/>
      </DockPanel>
      <TextBlock x:Name="HomeDirectoryEmptyText" Text="Connect a server directory in Settings to see published communities here." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <ItemsControl x:Name="HomeServerList" ItemTemplate="{StaticResource ServerCardTemplate}"/>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="ServersPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <Border Background="{StaticResource PanelBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,16">
       <DockPanel>
        <StackPanel><TextBlock Text="COMMUNITY DIRECTORY" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="DirectoryStatusText" Text="Configure a directory URL in Settings to load communities." Foreground="{StaticResource MutedBrush}" Margin="0,5,15,0" TextWrapping="Wrap"/></StackPanel>
        <Button DockPanel.Dock="Right" Content="REFRESH" Click="RefreshServers_Click" VerticalAlignment="Center"/>
       </DockPanel>
      </Border>
      <ItemsControl x:Name="ServerList" ItemTemplate="{StaticResource ServerCardTemplate}"/>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="CharactersPage" Visibility="Collapsed">
     <Border Background="{StaticResource PanelBrush}" Padding="22" CornerRadius="10">
      <StackPanel><TextBlock Text="CHARACTER MANAGEMENT" FontSize="20" FontWeight="Bold"/><TextBlock Text="Character creation and profile synchronization will be connected to the framework account service in a later milestone." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel>
     </Border>
    </ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
     <Border Background="{StaticResource PanelBrush}" Padding="22" CornerRadius="10">
      <StackPanel>
       <TextBlock Text="SETTINGS" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
       <TextBlock Text="SERVER DIRECTORY URL" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
       <TextBox x:Name="DirectoryUrlBox" Padding="9" Margin="0,0,0,14"/>
       <TextBlock Text="SPACE ENGINEERS EXECUTABLE (OPTIONAL)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
       <TextBox x:Name="GamePathBox" Padding="9" Margin="0,0,0,10"/>
       <Button Content="DETECT GAME INSTALLATION" HorizontalAlignment="Left" Click="DetectGame_Click"/>
       <Button Content="SAVE SETTINGS" Background="{StaticResource AccentBrush}" Foreground="#0B1712" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveSettings_Click"/>
       <TextBlock x:Name="SettingsStatusText" Text="Settings are stored locally." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
      </StackPanel>
     </Border>
    </ScrollViewer>
   </Grid>
  </Grid>
 </Grid>
</Window>
